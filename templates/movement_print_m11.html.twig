{#
 # Типова форма N М-11 (наказ Мінстату України від 21.06.96 р. N 193):
 # накладна-вимога на відпуск/внутрішнє переміщення матеріалів. Шапка,
 # підстава, отримувач і ціна кожного рядка редагуються прямо тут і
 # зберігаються на "Зберегти та надрукувати" (Engine\PrintM11::save()) --
 # решта полів форми (кореспондуючий рахунок, номер паспорта) не мають
 # відповідника в моделі даних плагіна й лишаються порожніми для ручного
 # заповнення -- див. Engine\PrintM11 та PROGRESS.md.
 #}
<style>
   .m11-page { max-width: 900px; margin: 1rem auto; font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #000; }
   .m11-toolbar { display: flex; justify-content: flex-end; gap: .5rem; margin-bottom: 1rem; }
   .m11-toolbar button { padding: .4rem 1rem; }
   .m11-saved-banner { background: #e6f7e6; border: 1px solid #3c9c3c; padding: .5rem .75rem; margin-bottom: 1rem; }
   .m11-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: .5rem; }
   .m11-org-line { border: 1px solid #000; min-width: 320px; padding: 2px; width: 100%; box-sizing: border-box; font-family: inherit; font-size: 13px; }
   .m11-org-caption { text-align: center; font-size: 11px; }
   .m11-form-ref { text-align: right; font-size: 12px; line-height: 1.3; }
   .m11-title { text-align: center; margin: 1rem 0; }
   .m11-title h3 { margin: 0; }
   table.m11-header, table.m11-items { width: 100%; border-collapse: collapse; margin-bottom: .75rem; }
   table.m11-header td, table.m11-header th,
   table.m11-items td, table.m11-items th { border: 1px solid #000; padding: 3px 5px; text-align: center; vertical-align: middle; font-size: 12px; }
   table.m11-items td.m11-name-cell { text-align: left; }
   .m11-line { margin: .6rem 0; }
   .m11-line .m11-fill { display: inline-block; border: 1px solid #000; min-width: 260px; padding: 2px 4px; font-family: inherit; font-size: 13px; }
   .m11-price-input { width: 90px; text-align: right; }
   .m11-signatures { display: flex; justify-content: space-between; margin-top: 1.5rem; }
   .m11-signatures div { width: 48%; }
   @media print {
      .m11-toolbar { display: none; }
      .m11-saved-banner { display: none; }
      .m11-page { margin: 0; max-width: none; }
      .m11-org-line, .m11-line .m11-fill, .m11-price-input { border: none; border-bottom: 1px solid #000; }
   }
</style>

<div class="m11-page">
   {% if saved %}
      <div class="m11-saved-banner">{{ __('Saved. A copy has been stored as a Document on this Movement.', 'assetmove') }}</div>
   {% endif %}

   <form method="post" action="{{ path('/plugins/assetmove/front/movement.print.php') }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="id" value="{{ movement.getID() }}">

      <div class="m11-toolbar">
         <button type="submit" name="save" value="1">{{ __('Save and print', 'assetmove') }}</button>
         <button type="button" onclick="window.print();">{{ __('Print', 'assetmove') }}</button>
      </div>

      <div class="m11-top">
         <div style="flex-grow: 1; margin-right: 1rem;">
            <textarea class="m11-org-line" name="print_header" rows="2">{{ header_requisites|default('') }}</textarea>
            <div class="m11-org-caption">{{ __('(підприємство, організація)', 'assetmove') }}</div>
         </div>
         <div class="m11-form-ref">
            <strong>{{ __('Типова форма N М-11', 'assetmove') }}</strong><br>
            {{ __('Затверджена наказом Мінстату України від 21.06.96 р. N 193', 'assetmove') }}
         </div>
      </div>

      <div class="m11-title">
         <h3>{{ __('НАКЛАДНА-ВИМОГА', 'assetmove') }}</h3>
         <div>{{ __('на відпуск /внутрішнє переміщення/ матеріалів', 'assetmove') }}</div>
      </div>

      <table class="m11-header">
         <tr>
            <th>{{ __('Номер документа', 'assetmove') }}</th>
            <th>{{ __('Дата складання', 'assetmove') }}</th>
            <th colspan="3">{{ __('Код виду операції', 'assetmove') }}</th>
         </tr>
         <tr>
            <td>{{ document_number }}</td>
            <td>{{ document_date ? document_date|formatted_date : '' }}</td>
            <td colspan="3">{{ doctype.fields['name']|default('') }}</td>
         </tr>
      </table>

      <div class="m11-line">
         {{ __('Підстава', 'assetmove') }}
         <input class="m11-fill" type="text" name="comment" value="{{ basis|default('') }}">
      </div>
      <div class="m11-line">
         {{ __('Кому', 'assetmove') }}
         <input class="m11-fill" type="text" name="print_recipient" value="{{ recipient_label|default('') }}">
      </div>

      <table class="m11-items">
         <tr>
            <th rowspan="2">{{ __('Порядковий номер', 'assetmove') }}</th>
            <th rowspan="2">{{ __('Матеріальні цінності (найменування, сорт, розмір, марка)', 'assetmove') }}</th>
            <th rowspan="2">{{ __('Одиниця виміру', 'assetmove') }}</th>
            <th colspan="2">{{ __('Кількість', 'assetmove') }}</th>
            <th rowspan="2">{{ __('Ціна', 'assetmove') }}</th>
            <th rowspan="2">{{ __('Сума', 'assetmove') }}</th>
            <th rowspan="2">{{ __('Інвентарний номер', 'assetmove') }}</th>
         </tr>
         <tr>
            <th>{{ __('відправлено', 'assetmove') }}</th>
            <th>{{ __('прийнято', 'assetmove') }}</th>
         </tr>
         {% for row in rows %}
            <tr>
               <td>{{ row.order }}</td>
               <td class="m11-name-cell">{{ row.name }}</td>
               <td>{{ row.unit }}</td>
               <td>{{ row.quantity }}</td>
               <td>{{ row.quantity }}</td>
               <td>
                  <input class="m11-price-input js-m11-price" type="number" step="0.01" min="0"
                         name="price[{{ row.id }}]" value="{{ row.price }}" data-qty="{{ row.quantity }}" data-row="{{ row.id }}">
               </td>
               <td><span class="js-m11-sum" data-row="{{ row.id }}">{{ row.sum|number_format(2, '.', ' ') }}</span></td>
               <td>{{ row.serial }}</td>
            </tr>
         {% else %}
            <tr>
               <td colspan="8">{{ __('No item in this document yet.', 'assetmove') }}</td>
            </tr>
         {% endfor %}
      </table>

      <div class="m11-line">
         {{ __('Всього відпущено', 'assetmove') }} <span class="m11-fill" style="min-width: auto;">{{ rows|length }}</span>
         {{ __('найменувань, на суму', 'assetmove') }}
         <span class="m11-fill" id="js-m11-total-sum">{{ total_sum|number_format(2, '.', ' ') }}</span>
      </div>

      <div class="m11-signatures">
         <div>{{ __('Здав (відпустив)', 'assetmove') }} <span class="m11-fill">{{ handed_over_by|default('') }}</span></div>
         <div>{{ __('Прийняв (одержав)', 'assetmove') }} <span class="m11-fill">{{ received_by|default('') }}</span></div>
      </div>
   </form>
</div>

<script>
   (function () {
      function recalc() {
         var total = 0;
         document.querySelectorAll('.js-m11-price').forEach(function (input) {
            var qty = parseFloat(input.dataset.qty) || 0;
            var price = parseFloat((input.value || '0').replace(',', '.')) || 0;
            var sum = qty * price;
            total += sum;

            var sumEl = document.querySelector('.js-m11-sum[data-row="' + input.dataset.row + '"]');
            if (sumEl) {
               sumEl.textContent = sum.toFixed(2);
            }
         });

         var totalEl = document.getElementById('js-m11-total-sum');
         if (totalEl) {
            totalEl.textContent = total.toFixed(2);
         }
      }

      document.querySelectorAll('.js-m11-price').forEach(function (input) {
         input.addEventListener('input', recalc);
      });
   })();
</script>
